# ~/.profile: executed by Bourne-compatible login shells.

if [ -n "${BASH_VERSION:-}" ]; then
  if [ -f ~/.bashrc ]; then
    . ~/.bashrc
  fi
fi

mesg n 2> /dev/null || true

##########################################
PS1='\[\e[1;33m\]\u@\h\[\e[0m\]:\w\$ '

case $- in
  *i*)
    if [ -t 1 ] && command -v katsu-dashboard >/dev/null 2>&1; then
      clear
      katsu-dashboard
    fi
    ;;
esac
